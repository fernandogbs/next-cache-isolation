{
  "name": "next-cache-isolation",
  "version": "0.2.0",
  "description": "Dynamic cache isolation testing for Next.js multi-tenant App Router apps",
  "license": "MIT",
  "type": "module",
  "bin": {
    "next-cache-isolation": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "catalogs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "test:published": "npm run build && node dist/cli/index.js test --suite published",
    "test:stress": "bash ./scripts/stress-suite.sh"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "redis": "^5.12.1",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
