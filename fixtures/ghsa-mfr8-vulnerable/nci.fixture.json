{
  "id": "ghsa-mfr8-vulnerable",
  "advisory": "GHSA-mfr8-8qww-v76h",
  "expected": "FAIL",
  "nextVersion": "16.3.0",
  "cacheComponents": true,
  "healthPath": "/nci/health",
  "cachePolicy": "memory",
  "scenario": {
    "id": "mfr8-cold-fill-race",
    "rootParamName": "locale",
    "contexts": [
      {
        "id": "pt",
        "rootParams": { "locale": "pt-BR" },
        "sentinel": "NCI_SENTINEL_PT_BR"
      },
      {
        "id": "en",
        "rootParams": { "locale": "en-US" },
        "sentinel": "NCI_SENTINEL_EN_US"
      }
    ],
    "paths": {
      "direct": "/{locale}/direct",
      "unstable": "/{locale}/unstable",
      "observe": "/{locale}/observe"
    },
    "latch": {
      "enabled": true,
      "holdMs": 3000,
      "armPath": "/nci/latch/arm",
      "releasePath": "/nci/latch/release"
    },
    "oracle": {
      "type": "body-sentinel",
      "observeContext": "en",
      "raceDirectContext": "pt",
      "raceUnstableContext": "en",
      "mustContain": "NCI_SENTINEL_EN_US",
      "mustNotContain": ["NCI_SENTINEL_PT_BR"],
      "acceptErrorWithoutForbidden": false
    }
  }
}
